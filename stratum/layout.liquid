<!doctype html>
<html lang="{{ lang }}" class="{{ site.template }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% comment %}
    Light is the default scheme. Stamp data-theme before first paint so
    light-dark() resolves from a known state and the toggle flips both ways
    even when the visitor's OS prefers dark.
  {% endcomment %}
  <script>try{var t=localStorage.getItem('blockhouse-theme');document.documentElement.dataset.theme=(t==='dark'||t==='light')?t:'light';var z=localStorage.getItem('blockhouse-textsize');if(z==='l'||z==='xl')document.documentElement.dataset.textsize=z}catch(e){document.documentElement.dataset.theme='light'}</script>
  {{ head }}
  <link rel="stylesheet" href="{{ 'tokens.css' | asset }}">
  <link rel="stylesheet" href="{{ 'base.css' | asset }}">
  <link rel="stylesheet" href="{{ 'components.css' | asset }}">
</head>
<body {{ body_attrs }}>
  <a class="skip-link" href="#main">Skip to content</a>
  {% include 'partials/header' %}
  <main id="main">
    {{ main }}
  </main>
  {% include 'partials/footer' %}
  <script>
    /* ---- drawings -------------------------------------------------------
       Every schematic is one SVG that reads its URL fragment: "" runs with
       callout numbers, #p drops the numbers, #s stops the motion, #ps does
       both, #hN focuses one component. Swapping the fragment costs nothing —
       the file is already cached — so hover and focus states are just src
       changes. */
    ;(function () {
      var base = function (img) { return img.getAttribute('src').split('#')[0] }
      var set = function (img, frag) {
        var next = base(img) + (frag || '')
        if (img.getAttribute('src') !== next) img.setAttribute('src', next)
      }
      var rest = function (host) {
        var still = host.dataset.artMotion === 'off' || host.dataset.artMotion === 'hover'
        var plain = host.dataset.artLeaders === 'false'
        return plain ? (still ? '#ps' : '#p') : (still ? '#s' : theme())
      }
      /* A drawing inside an <img> cannot see the site's theme — left alone it
         follows the visitor's operating system, so a light page on a dark-mode
         laptop got dark drawings. With no other fragment to carry, say which. */
      var theme = function () { return document.documentElement.dataset.theme === 'dark' ? '#dark' : '#light' }
      var play = function (host) { return host.dataset.artLeaders === 'false' ? '#p' : theme() }

      document.querySelectorAll('[data-art]').forEach(function (host) {
        var img = host.querySelector('img')
        if (!img) return
        set(img, rest(host))
        if (host.dataset.artMotion === 'hover') {
          host.addEventListener('pointerenter', function () { set(img, play(host)) })
          host.addEventListener('pointerleave', function () { set(img, rest(host)) })
        }
        var badge = host.querySelector('[data-art-badge]')
        var notes = host.querySelectorAll('[data-art-part]')
        notes.forEach(function (note, i) {
          var focus = function () {
            set(img, '#h' + (i + 1))
            note.classList.add('is-focus')
            if (badge) { badge.hidden = false; badge.textContent = note.querySelector('strong').textContent }
          }
          var blur = function () {
            set(img, rest(host))
            note.classList.remove('is-focus')
            if (badge) badge.hidden = true
          }
          note.addEventListener('pointerenter', focus)
          note.addEventListener('pointerleave', blur)
          note.addEventListener('focus', focus)
          note.addEventListener('blur', blur)
        })
      })

      /* every other drawing on the page (a photo row, a product cover) */
      var plainSvgs = function () {
        document.querySelectorAll('main img[src*=".svg"]').forEach(function (img) {
          if (img.closest('[data-art], .sys-card, .mc-item, .mega-card, .rel-card, .post-card')) return
          var frag = (img.getAttribute('src').split('#')[1] || '')
          if (frag === '' || frag === 'light' || frag === 'dark') {
            img.removeAttribute('srcset'); set(img, theme())
          }
        })
        document.querySelectorAll('[data-art]').forEach(function (host) {
          var img = host.querySelector('img'); if (img) { img.removeAttribute('srcset'); set(img, rest(host)) }
        })
      }
      plainSvgs()
      new MutationObserver(plainSvgs).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] })

      /* cards and menu thumbnails stay still until you point at them, so a
         catalogue of 26 systems is not 26 things moving at once */
      document.querySelectorAll('.sys-card, .mc-item, .mega-card, .rel-card, .post-card').forEach(function (card) {
        var img = card.querySelector('img')
        if (!img || !/\.svg/.test(img.getAttribute('src') || '')) return
        set(img, '#ps')
        card.addEventListener('pointerenter', function () { set(img, '#p') })
        card.addEventListener('pointerleave', function () { set(img, '#ps') })
      })
    })();

    /* ---- tables that split into rows on a phone -------------------------- */
    ;(function () {
      document.querySelectorAll('[data-table-mobile="split"]').forEach(function (wrap) {
        var heads = [].map.call(wrap.querySelectorAll('thead th'), function (th) { return th.textContent.trim() })
        if (!heads.length) return
        wrap.querySelectorAll('tbody tr').forEach(function (tr) {
          [].forEach.call(tr.children, function (td, i) { if (heads[i]) td.setAttribute('data-label', heads[i]) })
        })
      })
    })();

    /* ---- mega menu behaviour -------------------------------------------- */
    (function () {
      var header = document.querySelector('.site-header')
      if (!header) return
      var body = document.body
      var mode = header.dataset.navTrigger || 'hover'
      var veil = header.dataset.navBackdrop || 'none'
      var open = null

      function close() {
        if (!open) return
        open.classList.remove('open')
        var b = open.querySelector('.nav-link'); if (b) b.setAttribute('aria-expanded', 'false')
        open = null
        body.classList.remove('nav-veiled', 'nav-locked')
        body.removeAttribute('data-nav-veil')
      }
      function show(item) {
        if (open === item) return close()
        close()
        item.classList.add('open')
        var b = item.querySelector('.nav-link'); if (b) b.setAttribute('aria-expanded', 'true')
        open = item
        if (veil !== 'none') { body.classList.add('nav-veiled'); body.setAttribute('data-nav-veil', veil) }
      }

      document.querySelectorAll('.site-header .nav-item.has-mega, .site-header .nav-item.has-drop').forEach(function (item) {
        var link = item.querySelector(':scope > .nav-link')
        if (!link) return
        if (mode === 'click' || mode === 'hover') {
          link.addEventListener('click', function () {
            if (matchMedia('(max-width: 1000px)').matches) return   // drill-down owns mobile
            setTimeout(function () { open = item.classList.contains('open') ? item : null
              if (open) {
                if (veil !== 'none') { body.classList.add('nav-veiled'); body.setAttribute('data-nav-veil', veil) }
                if (header.dataset.navFill === 'true') body.classList.add('nav-locked')
              } else { body.classList.remove('nav-veiled', 'nav-locked'); body.removeAttribute('data-nav-veil') } }, 0)
          })
        }
        if (mode === 'hover' && veil !== 'none') {
          item.addEventListener('pointerenter', function () {
            if (matchMedia('(max-width: 1000px)').matches) return
            body.classList.add('nav-veiled'); body.setAttribute('data-nav-veil', veil)
            if (header.dataset.navFill === 'true') body.classList.add('nav-locked')
          })
          item.addEventListener('pointerleave', function () {
            if (!item.classList.contains('open')) { body.classList.remove('nav-veiled', 'nav-locked'); body.removeAttribute('data-nav-veil') }
          })
        }
        // close button on full-screen panels
        var panel = item.querySelector('.mega-panel')
        if (panel && header.dataset.navFill === 'true' && !panel.querySelector('.mega-close')) {
          var x = document.createElement('button')
          x.type = 'button'; x.className = 'mega-close'; x.setAttribute('aria-label', 'Close menu')
          x.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>'
          x.addEventListener('click', function (e) { e.stopPropagation(); close(); link.blur() })
          panel.appendChild(x)
        }
      })

      document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape') return
        close()
        document.querySelectorAll('.nav-item.open, .nav-item.drilled').forEach(function (i) { i.classList.remove('open', 'drilled') })
        body.classList.remove('nav-veiled', 'nav-locked'); body.removeAttribute('data-nav-veil')
        if (body.classList.contains('nav-open')) {
          body.classList.remove('nav-open')
          var burger = document.querySelector('[data-blockhouse="burger"]')
          if (burger) burger.setAttribute('aria-expanded', 'false')
        }
      })
      document.addEventListener('click', function (e) {
        if (open && !header.contains(e.target)) close()
      })
    })();

    /* ---- map -------------------------------------------------------------
       The map loads itself as it comes into view; nobody should have to click
       a grey box to see where the company is. */
    ;(function () {
      var maps = document.querySelectorAll('.wb-map[data-embed]')
      if (!maps.length) return
      var load = function (m) { var b = m.querySelector('.embed-facade'); if (b) b.click() }
      if (!('IntersectionObserver' in window)) { maps.forEach(load); return }
      var io = new IntersectionObserver(function (es) {
        es.forEach(function (e) { if (e.isIntersecting) { io.unobserve(e.target); load(e.target) } })
      }, { rootMargin: '300px' })
      maps.forEach(function (m) { io.observe(m) })
    })();

    /* ---- hero slider -----------------------------------------------------
       Stacked slides, cross-faded. Autoplay yields while the tab is hidden
       and never starts at all for a visitor who asked for reduced motion.
       Deliberately no pause-on-hover: the hero fills the top of the page, so
       a cursor merely resting there would stop the rotation for good and the
       slider would look broken. With no JS the first slide simply shows. */
    (function () {
      document.querySelectorAll('[data-hero-slider]').forEach(function (hero) {
        var slides = [].slice.call(hero.querySelectorAll('.sm-hero-slide'))
        if (!slides.length) return
        if (slides.length < 2) { slides[0].classList.add('is-active'); return }

        var dots = [].slice.call(hero.querySelectorAll('.sm-hero-dots button'))
        var interval = parseInt(hero.dataset.heroInterval, 10) || 6000
        var i = 0, paused = false
        var still = matchMedia('(prefers-reduced-motion: reduce)').matches

        function show(n) {
          i = (n + slides.length) % slides.length
          slides.forEach(function (s, x) {
            s.classList.toggle('is-active', x === i)
            if (x === i) s.removeAttribute('aria-hidden'); else s.setAttribute('aria-hidden', 'true')
          })
          dots.forEach(function (d, x) { d.setAttribute('aria-current', String(x === i)) })
        }
        dots.forEach(function (d, x) { d.addEventListener('click', function () { show(x) }) })
        document.addEventListener('visibilitychange', function () { paused = document.hidden })

        /* Drag / swipe. The slides cross-fade rather than slide, so the gesture
           is read and committed on release instead of tracking the pointer —
           there is nothing to move under the finger. */
        var view = hero.querySelector('.sm-hero-view') || hero
        var startX = 0, startY = 0, dragging = false, decided = false

        /* Pressing an <img> starts the browser's own image drag, which
           swallows the pointerup that would end the gesture — and with it the
           clearing of `paused`, which is how autoplay silently dies. */
        view.addEventListener('dragstart', function (e) { e.preventDefault() })
        view.addEventListener('pointerdown', function (e) {
          if (e.button !== undefined && e.button !== 0) return
          startX = e.clientX; startY = e.clientY
          dragging = true; decided = false; paused = true
          try { view.setPointerCapture(e.pointerId) } catch (err) {}
        })
        view.addEventListener('pointermove', function (e) {
          if (!dragging || decided) return
          var dx = e.clientX - startX, dy = e.clientY - startY
          if (Math.abs(dy) > Math.abs(dx)) { dragging = false; paused = false; return }
          if (Math.abs(dx) > 12) { decided = true; view.classList.add('is-dragging') }
        })
        function endDrag(e) {
          view.classList.remove('is-dragging')
          if (!dragging) { paused = false; return }
          var dx = ((e && e.clientX) || startX) - startX
          dragging = false
          if (Math.abs(dx) > 60) show(dx < 0 ? i + 1 : i - 1)
          paused = false
        }
        view.addEventListener('pointerup', endDrag)
        view.addEventListener('pointercancel', endDrag)
        addEventListener('pointerup', endDrag)
        addEventListener('blur', function () { dragging = false; paused = false })
        view.addEventListener('click', function (e) {
          if (decided) { e.preventDefault(); e.stopPropagation(); decided = false }
        }, true)

        show(0)
        if (!still) setInterval(function () { if (!paused) show(i + 1) }, interval)
      })
    })();

    /* ---- gallery lightbox ------------------------------------------------
       A row of photographs wants to be walked through, so a [data-gallery] row
       opens as one set with next/prev, arrow keys, a counter and the caption.
       Capture phase plus stopPropagation keeps the runtime's own one-shot
       viewer from firing on the same click. */
    document.addEventListener('click', function (e) {
      var fig = e.target.closest && e.target.closest('[data-gallery] [data-lightbox]')
      if (!fig) return
      e.preventDefault()
      e.stopPropagation()

      var figures = [].slice.call(fig.closest('[data-gallery]').querySelectorAll('[data-lightbox]'))
      var at = figures.indexOf(fig)
      var many = figures.length > 1

      var box = document.createElement('div')
      box.className = 'lightbox-overlay is-gallery'
      box.setAttribute('role', 'dialog')
      box.setAttribute('aria-modal', 'true')
      box.setAttribute('aria-label', 'Image viewer')
      box.innerHTML =
        '<button class="lb-close" type="button" aria-label="Close">&times;</button>' +
        '<button class="lb-prev" type="button" aria-label="Previous image">&#8249;</button>' +
        '<figure class="lb-stage"><img alt=""><figcaption></figcaption></figure>' +
        '<button class="lb-next" type="button" aria-label="Next image">&#8250;</button>' +
        '<p class="lb-count" aria-live="polite"></p>'

      var img = box.querySelector('img')
      var cap = box.querySelector('figcaption')
      var count = box.querySelector('.lb-count')
      box.querySelector('.lb-prev').hidden = !many
      box.querySelector('.lb-next').hidden = !many

      function show(n) {
        at = (n + figures.length) % figures.length
        var src = figures[at].querySelector('img')
        if (!src) return
        img.src = src.currentSrc || src.src
        img.alt = src.alt || ''
        var c = figures[at].querySelector('figcaption')
        cap.textContent = c ? c.textContent : ''
        cap.hidden = !cap.textContent
        count.textContent = many ? (at + 1) + ' / ' + figures.length : ''
      }
      function close() {
        box.remove()
        document.removeEventListener('keydown', onKey)
        document.body.style.overflow = ''
      }
      function onKey(ev) {
        if (ev.key === 'Escape') close()
        else if (ev.key === 'ArrowRight' && many) show(at + 1)
        else if (ev.key === 'ArrowLeft' && many) show(at - 1)
      }
      box.querySelector('.lb-close').addEventListener('click', close)
      box.querySelector('.lb-prev').addEventListener('click', function (ev) { ev.stopPropagation(); show(at - 1) })
      box.querySelector('.lb-next').addEventListener('click', function (ev) { ev.stopPropagation(); show(at + 1) })
      box.addEventListener('click', function (ev) { if (ev.target === box) close() })
      document.addEventListener('keydown', onKey)

      show(at)
      document.body.style.overflow = 'hidden'
      document.body.appendChild(box)
      box.querySelector('.lb-close').focus()
    }, true);

    /* ---- text size ------------------------------------------------------ */
    (function () {
      var root = document.documentElement
      function apply(size) {
        if (size === 'm') delete root.dataset.textsize; else root.dataset.textsize = size
        try { localStorage.setItem('blockhouse-textsize', size) } catch (e) {}
        for (var b of document.querySelectorAll('[data-textsize-set]'))
          b.setAttribute('aria-pressed', String(b.dataset.textsizeSet === size))
      }
      for (var b of document.querySelectorAll('[data-textsize-set]'))
        b.addEventListener('click', function () { apply(this.dataset.textsizeSet) })
      apply(root.dataset.textsize || 'm')
    })()
  </script>
</body>
</html>
