{
  "type": "stage",
  "label": "Opening banner",
  "group": "Stratum",
  "icon": "mountain",
  "description": "A dark opening banner across the full width: a small label, a very large headline, a drawing and a strip of headline numbers.",
  "fields": [
    {
      "key": "eyebrow",
      "type": "text",
      "label": "Micro-label",
      "help": "A short line above the headline."
    },
    {
      "key": "title",
      "type": "text",
      "label": "Headline",
      "required": true
    },
    {
      "key": "titleThin",
      "type": "text",
      "label": "Headline — second line",
      "help": "Shown in a lighter weight, under the first line."
    },
    {
      "key": "text",
      "type": "textarea",
      "label": "Intro",
      "rows": 3
    },
    {
      "key": "image",
      "type": "image",
      "label": "Artwork",
      "help": "A technical drawing works better here than a photo."
    },
    {
      "key": "layout",
      "type": "select",
      "label": "Layout",
      "options": [
        { "value": "split", "label": "Text beside the artwork" },
        { "value": "center", "label": "Centred" }
      ],
      "default": "split",
      "width": "half"
    },
    {
      "key": "height",
      "type": "select",
      "label": "Height",
      "options": [
        { "value": "normal", "label": "Normal" },
        { "value": "tall", "label": "Tall" }
      ],
      "default": "normal",
      "width": "half"
    },
    {
      "key": "caption",
      "type": "text",
      "label": "Drawing caption",
      "help": "Shown under the artwork plate, e.g. 'Fig. 01 — tower arrangement'"
    },
    {
      "key": "buttons",
      "type": "list",
      "label": "Buttons",
      "item": [
        {
          "key": "label",
          "type": "text",
          "label": "Label"
        },
        {
          "key": "href",
          "type": "text",
          "label": "Link"
        },
        {
          "key": "style",
          "type": "select",
          "label": "Style",
          "options": [
            { "value": "primary", "label": "Solid (main action)" },
            { "value": "ghost", "label": "Outlined" }
          ],
          "default": "primary"
        }
      ]
    },
    {
      "key": "meta",
      "type": "list",
      "label": "Key figures",
      "item": [
        {
          "key": "k",
          "type": "text",
          "label": "Label"
        },
        {
          "key": "v",
          "type": "text",
          "label": "Value"
        }
      ]
    }
  ],
  "defaults": {
    "layout": "split",
    "height": "normal",
    "buttons": [],
    "meta": []
  },
  "providesH1": true
}
