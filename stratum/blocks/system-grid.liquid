<div class="sb-grid cols-{{ props.cols | default: '3' }}">
  {% for s in props.items %}
    <a class="sys-card" href="{{ s.href | default: '#' }}">
      <span class="sys-media"{{ 'items' | wbe_at: forloop.index0, 'image', 'img' }}>
        {% if s.image %}{{ s.image | img: width: 640, sizes: '(max-width: 720px) 92vw, 340px' }}{% endif %}
        {% if s.code %}<span class="sys-code"{{ 'items' | wbe_at: forloop.index0, 'code' }}>{{ s.code | escape }}</span>{% endif %}
        {% if s.brand %}<span class="sys-brand"{{ 'items' | wbe_at: forloop.index0, 'brand' }}>{{ s.brand | escape }}</span>{% endif %}
      </span>
      <span class="sys-body">
        <span class="sys-name"{{ 'items' | wbe_at: forloop.index0, 'name' }}>{{ s.name | escape }}</span>
        {% if s.text %}<span class="sys-text"{{ 'items' | wbe_at: forloop.index0, 'text' }}>{{ s.text | escape }}</span>{% endif %}
        {% if s.k1 %}
          <span class="sys-specs">
            <span class="row"><span class="k"{{ 'items' | wbe_at: forloop.index0, 'k1' }}>{{ s.k1 | escape }}</span><span class="v"{{ 'items' | wbe_at: forloop.index0, 'v1' }}>{{ s.v1 | escape }}</span></span>
            {% if s.k2 %}<span class="row"><span class="k"{{ 'items' | wbe_at: forloop.index0, 'k2' }}>{{ s.k2 | escape }}</span><span class="v"{{ 'items' | wbe_at: forloop.index0, 'v2' }}>{{ s.v2 | escape }}</span></span>{% endif %}
          </span>
        {% endif %}
        <span class="sys-more">View system →</span>
      </span>
    </a>
  {% endfor %}
</div>
