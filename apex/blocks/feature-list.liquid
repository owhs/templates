<div class="wb-feature-list">
  {% for item in props.items %}
    <div class="feature-list-item">
      <span class="feature-icon" aria-hidden="true">{{ item.icon | icon: 22 }}</span>
      <div>
        <h3{{ 'items' | wbe_at: forloop.index0, 'title' }}>{{ item.title | escape }}</h3>
        {% if item.text %}<p{{ 'items' | wbe_at: forloop.index0, 'text' }}>{{ item.text | escape }}</p>{% endif %}
      </div>
    </div>
  {% endfor %}
</div>