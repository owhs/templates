<div class="related-products">
  {% if props.title %}<h2 class="related-products__title"{{ 'title' | wbe }}>{{ props.title | escape }}</h2>{% endif %}
  <div class="cards-grid related-products__grid">
    {% for it in props.items %}
      <article class="card anim-hidden">
        <a class="card" href="{{ it.href }}">
          {% if it.image %}<figure class="card__image"{{ 'items' | wbe_at: forloop.index0, 'image', 'img' }}>{{ it.image | img: width: 480, sizes: '(max-width: 700px) 50vw, 300px' }}</figure>{% endif %}
          <div class="card__content">
            <h3 class="card__title"{{ 'items' | wbe_at: forloop.index0, 'name' }}>{{ it.name | escape }}</h3>
            {% if it.strapline %}<p class="card__meta"{{ 'items' | wbe_at: forloop.index0, 'strapline' }}>{{ it.strapline | escape }}</p>{% endif %}
            {% if it.reason %}<p class="card__entry"{{ 'items' | wbe_at: forloop.index0, 'reason' }}>{{ it.reason | escape }}</p>{% endif %}
          </div>
        </a>
      </article>
    {% endfor %}
  </div>
</div>
