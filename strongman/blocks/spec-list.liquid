{% comment %}
  The specification table. Every product sidebar and every guide uses this one
  block, so the numbers all read the same way across the site.

  A row is label · value · optional note. The note renders as a muted second
  line under the value — the right home for qualifiers like "7050 lb" or "can
  stop at any point". (The rendering engine has no split filter, so the
  splitting is done in the content: anything that was written
  "1848 mm (can stop at any point)" is stored as value "1848 mm" plus a note.
  The brackets are drawn by CSS, so stored data stays clean.)
{% endcomment %}
<div class="spec-block">
  {% if props.title %}
    <h3 class="spec-title">{% if props.icon %}<span class="spec-title__icon">{{ props.icon | icon: 15 }}</span>{% endif %}{{ props.title | escape }}</h3>
  {% endif %}

  <table class="spec-table">
    <tbody>
      {% for r in props.rows %}
        <tr class="spec-row">
          <th scope="row">{{ r.label | escape }}</th>
          <td><span class="spec-val">{{ r.value | escape }}</span>{% if r.note %}<span class="spec-sub">{{ r.note | escape }}</span>{% endif %}</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>

  {% if props.note %}<p class="spec-note">{{ props.note | escape }}</p>{% endif %}
</div>
