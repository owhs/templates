        { "key": "image", "type": "image", "label": "Cover image" },
        { "key": "name", "type": "text", "label": "Name" },
        { "key": "strapline", "type": "text", "label": "Strapline" },
        { "key": "reason", "type": "text", "label": "Why it's related", "help": "Short phrase, e.g. “Same footprint, taller lift”" },
        { "key": "href", "type": "text", "label": "Link", "help": "e.g. /glenfinnan/" }
      ]
    }
  ],
  "defaults": { "items": [] }
