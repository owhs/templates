<nav class="link-row align-{{ props.align | default: 'center' }} grid-wide" aria-label="Models in this range">
  {% for l in props.links %}
    <a href="{{ l.href }}"{% if l.title %} title="{{ l.title | escape }}"{% endif %}><span{{ 'links' | wbe_at: forloop.index0, 'label' }}>{{ l.label | escape }}</span></a>
  {% endfor %}
</nav>
